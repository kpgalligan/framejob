---
/* The system's standard page opener: a mono uppercase eyebrow naming the
   section 12px above the h1, then the page description 16px below it.
   Starlight renders the h1 alone and puts the description in <head> only. The
   type is boppa-llewyn.css's. */
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

/** Starlight's id for the top-of-page anchor the skip link targets. */
const PAGE_TITLE_ID = '_top';

const { entry, sidebar } = Astro.locals.starlightRoute;

/** The label of the sidebar group the current page sits in, if any. */
function currentGroupLabel(
  entries: StarlightRouteData['sidebar'],
  label?: string,
): string | undefined {
  for (const item of entries) {
    if (item.type === 'link') {
      if (item.isCurrent) return label;
    } else {
      const found = currentGroupLabel(item.entries, item.label);
      if (found) return found;
    }
  }
  return undefined;
}

const eyebrow = entry.data.eyebrow ?? currentGroupLabel(sidebar);
const { description } = entry.data;
---

{eyebrow && <p class="page-eyebrow">{eyebrow}</p>}
<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
{description && <p class="page-description">{description}</p>}

<style>
  @layer starlight.core {
    h1 {
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
    }

    .page-eyebrow + h1 {
      margin-top: 0.75rem;
    }

    h1 + .page-description {
      margin-top: 1rem;
    }
  }
</style>
