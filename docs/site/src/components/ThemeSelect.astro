---
/* The site has exactly two looks, Neutral Light and Neutral Dark, so the stock
   three-option auto/light/dark <select> becomes a two-state toggle: a 36px ghost
   button like the header's other icon buttons. The stored key and the
   `data-theme` attribute stay Starlight's, so ThemeProvider's no-FOUC inline
   script keeps working unchanged. */
import { Icon } from '@astrojs/starlight/components';
---

<starlight-theme-select>
  <button type="button" class="theme-toggle">
    <Icon name="moon" class="icon-dark" size="1rem" />
    <Icon name="sun" class="icon-light" size="1rem" />
    <span class="sr-only">{Astro.locals.t('themeSelect.accessibleLabel')}</span>
  </button>
</starlight-theme-select>

<script>
  /** Key in `localStorage` to store colour theme preference at — Starlight's own. */
  const storageKey = 'starlight-theme';

  const currentTheme = (): 'dark' | 'light' =>
    document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector('button');
      if (!button) return;
      const label = () => {
        // Name the destination, not the state: this is a control, not a status.
        button.setAttribute(
          'aria-label',
          currentTheme() === 'dark' ? 'Use the light theme' : 'Use the dark theme',
        );
      };
      label();
      button.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem(storageKey, next);
        } catch {}
        label();
      });
    }
  }
  customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
  @layer starlight.core {
    .theme-toggle {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      border: 0;
      border-radius: var(--bl-radius-md);
      background-color: transparent;
      color: var(--bl-ink-muted);
      cursor: pointer;
    }

    .theme-toggle:hover {
      background-color: var(--bl-surface-sunken);
      color: var(--bl-ink);
    }

    /* 36px box, 44px target. */
    .theme-toggle::after {
      content: '';
      position: absolute;
      inset: -0.25rem;
    }

    /* Show the look you are in, not the one you would switch to. */
    .icon-light {
      display: none;
    }

    :global(:root[data-theme='light']) .icon-dark {
      display: none;
    }

    :global(:root[data-theme='light']) .icon-light {
      display: block;
    }
  }
</style>
