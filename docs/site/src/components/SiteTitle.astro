---
/* Boppa Llewyn header lockup, as on Doctored's site: the company mark (three toy blocks), the
   company's name, a slash, the product's name and a mono version badge — "Boppa Llewyn / Frame
   Job v0.3". Below 50rem the company's name and the slash hide. Starlight's own SiteTitle renders
   the logo image and the title text only, and cannot carry the rest. */
import { Image } from 'astro:assets';
import { logos } from 'virtual:starlight/user-images';
import { APP_VERSION } from '../site';

/* The mark is an SVG drawn on a 1024px square: the header shows it at 32px, and one file serves
   every pixel density, so it takes no `densities`. Its alt is empty because the company's name
   follows it as text. */
const iconAttrs = { width: 32, height: 32, alt: '' };

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  {logos.dark && (
    <Image
      src={logos.dark}
      {...iconAttrs}
      class:list={{ 'light:sl-hidden': Boolean(logos.light && logos.light !== logos.dark) }}
    />
  )}
  {logos.light && logos.light !== logos.dark && (
    <Image src={logos.light} {...iconAttrs} class="dark:sl-hidden" />
  )}
  <span class="company">Boppa Llewyn</span>
  <span class="sep" aria-hidden="true">
    /
  </span>
  <span class="wordmark" translate="no">
    {siteTitle}
  </span>
  <span class="version" translate="no">
    v{APP_VERSION}
  </span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      gap: 0.5rem;
      color: var(--bl-ink);
      font-size: 1.0625rem;
      font-weight: 600;
      line-height: 1.5rem;
      letter-spacing: -0.02em;
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }

    img {
      width: 2rem;
      height: 2rem;
      flex-shrink: 0;
      object-fit: contain;
    }

    .sep {
      color: var(--bl-ink-subtle);
      font-weight: 400;
    }

    .wordmark {
      overflow: hidden;
      font-weight: 500;
    }

    .version {
      flex-shrink: 0;
      margin-inline-start: 0.25rem;
      padding: 2px 8px;
      font-family: var(--sl-font-mono);
      font-size: 0.75rem;
      font-weight: 500;
      line-height: 1rem;
      letter-spacing: 0;
      color: var(--bl-ink-subtle);
      border-radius: var(--bl-radius-pill);
      box-shadow: inset 0 0 0 1px var(--bl-line-strong);
    }

    @media (width < 50rem) {
      .company,
      .sep {
        display: none;
      }
    }
  }
</style>
