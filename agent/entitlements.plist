<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The helper's only entitlement. Bun's JavaScriptCore needs JIT memory;
	     under the hardened runtime without it the helper dies at launch
	     ("Ran out of executable memory"). The app itself needs none. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
