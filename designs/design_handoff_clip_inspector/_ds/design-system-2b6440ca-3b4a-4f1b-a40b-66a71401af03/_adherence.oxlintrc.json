{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/assistant/**",
              "components/controls/**",
              "components/panels/**",
              "components/timeline/**",
              "components/tools/**",
              "design_handoff_rasterize_sharp/design/**",
              "design_handoff_rasterize_sharp/design/runtime/**",
              "design_handoff_reelcut_sharp/design/**",
              "design_handoff_reelcut_sharp/design/runtime/**",
              "ui_kits/rasterize/**",
              "ui_kits/reelcut/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Sans 3|IBM Plex Mono|Darker Grotesque|Material Symbols Outlined))/i]",
        "message": "Font not provided by the design system. Available: Source Sans 3, IBM Plex Mono, Darker Grotesque, Material Symbols Outlined."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|fill|disabled|onClick|title|style|key|ref|className|style|children)$/]",
        "message": "<AccentButton> doesn't accept that prop. Declared props: children, icon, fill, disabled, onClick, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|emphasis|size|disabled|onClick|title|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, icon, emphasis, size, disabled, onClick, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='emphasis'] > Literal[value!=/^(?:default|strong)$/]",
        "message": "<Button> emphasis must be one of 'default' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|children|toolCalls|style|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: role, children, toolCalls, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:user|assistant)$/]",
        "message": "<ChatMessage> role must be one of 'user' | 'assistant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|label|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, label, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChromeBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|borderTop|children|style|key|ref|className|style|children)$/]",
        "message": "<ChromeBar> doesn't accept that prop. Declared props: variant, borderTop, children, style."
