     p.r = srgb_compress(p.r);
     p.g = srgb_compress(p.g);
     p.b = srgb_compress(p.b);
+
+    p.next_stage();
+}
+
+// Frame Job (spec §11 PR-13): the gradient dither. A fixed offset by pixel position, uniform
+// over ±DITHER_SPAN/2 of a level (7/16: under half, so a premultiplied value on a level stays
+// exact), the same for R, G and B, each clamped to [0, a]; alpha untouched. Reads only the
+// position: no frame, thread or global state.
+const DITHER_SPAN: f32 = 0.875;
+const DITHER_SEED: u32 = 0x9E37_79B9;
+
+// lowbias32 (Chris Wellons), with wrapping multiplies.
+#[inline(always)]
+fn dither_hash(mut x: u32) -> u32 {
+    x ^= x >> 16;
+    x = x.wrapping_mul(0x7feb352d);
+    x ^= x >> 15;
+    x = x.wrapping_mul(0x846ca68b);
+    x ^= x >> 16;
+    x
+}
+
+fn dither(p: &mut Pipeline) {
+    let y = p.dy as u32;
+    let row = dither_hash(y ^ DITHER_SEED);
+    let mut lanes = [0.0f32; STAGE_WIDTH];
+    for (i, v) in lanes.iter_mut().enumerate() {
+        let h = dither_hash(row ^ (p.dx + i) as u32);
+        *v = ((h >> 8) as f32 / 16_777_216.0 - 0.5) * DITHER_SPAN / 255.0;
+    }
+    let d = f32x8::from(lanes);
+    p.r = (p.r + d).max(f32x8::default()).min(p.a);
+    p.g = (p.g + d).max(f32x8::default()).min(p.a);
+    p.b = (p.b + d).max(f32x8::default()).min(p.a);
 
     p.next_stage();
 }
